# Copy to .env and fill in. Never commit .env.

# OpenRouter (OpenAI-compatible) — used for both chat and embeddings
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Two tiers: cheap model on every request (router + grader), better one answers
ANSWER_MODEL=google/gemini-3.6-flash
FAST_MODEL=google/gemini-3.5-flash-lite

EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Ingest-only in practice — retrieval embeds one query at a time.
EMBEDDING_BATCH_SIZE=64

RERANK_ENABLED=true
RERANK_MODEL=cohere/rerank-v3.5

# Postgres — backs both pgvector retrieval and LangGraph session checkpointing.
# On Railway use the PUBLIC connection string when running ingest from a laptop;
# the *.railway.internal host only resolves inside Railway's own network.
DATABASE_URL=postgresql://user:pass@localhost:5432/mal
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=15

# Retrieval — two-stage: fetch candidates, rerank down to top_k
RETRIEVE_CANDIDATES=20
TOP_K=4
MAX_RETRIEVAL_ATTEMPTS=2

# No RELEVANCE_THRESHOLD by design: relevance is the LLM grader's decision, never
# a cosine cutoff. Similarity scores are recorded for the trace only.

# Conversation history carried in graph state, in messages — 20 is 10 turns.
# Uncapped, a long session grows every checkpoint and every prompt with it.
HISTORY_MAX_MESSAGES=20

# PII. `lg` rather than `sm` because NER is the whole defence for customer
# names; the threshold is low on purpose — over-redaction costs a little answer
# quality, a missed identifier leaks into a prompt, a log and a trace at once.
PII_SPACY_MODEL=en_core_web_lg
PII_SCORE_THRESHOLD=0.35
# JSON list. Allowlisted: Presidio's full set fires low-confidence guesses at
# formats irrelevant to a UAE bank (US driver's licence, US bank number).
PII_ENTITIES=["PERSON","EMAIL_ADDRESS","PHONE_NUMBER","CREDIT_CARD","IBAN_CODE","EMIRATES_ID","ACCOUNT_NUMBER"]

LOG_LEVEL=INFO

# --- Tests only, not read by the app -------------------------------------
# A throwaway pgvector database for `pytest -m db`: those tests call prune() and
# replace_document(), so this must never be DATABASE_URL.
TEST_DATABASE_URL=
# Judge model for the grounding eval (deepeval, live only).
EVAL_JUDGE_MODEL=openai/gpt-5.6-luna
